# Copy this file to .env and adjust per unit. Rebuild after changing.
# These are the ONLY things you normally change to rebrand/reconfigure a unit.

# --- Branding (what the customer sees) ---
BRAND_NAME="Family Vault"
BRAND_TAGLINE="Private, local AI over your own files. Your data never leaves home."

# --- Vaults (the separate, access-controlled areas) ---
# Format: "id:Label,id2:Label 2". Owners always get all vaults; members get assigned ones.
VAULTS="work:Work (confidential),family:Family"

# --- Local AI model (served by Ollama) ---
# Use a bigger model on a real rig (e.g. qwen2.5:7b or llama3.1:8b). qwen2.5:0.5b is a tiny demo model.
OLLAMA_MODEL="qwen2.5:0.5b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_URL="http://127.0.0.1:11434"

# --- Security ---
# Strong passphrase used to derive the encryption key. If set, the key is NEVER stored on disk
# (best protection, survives full-disk theft). Keep it safe — losing it means losing the data.
VAULT_PASSPHRASE=""
# Session signing secret. Leave blank to auto-generate & persist a strong one on first run.
SESSION_SECRET=""

# --- Demo mode ---
# Set to 1 ONLY for your own demos (seeds dad/kid sample accounts). Leave OFF for real units.
SEED_DEMO="0"
