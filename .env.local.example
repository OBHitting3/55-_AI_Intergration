# AI Bridge Sync — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Dashboard Authentication ────────────────────────────────────────────────
# Simple password protecting the entire dashboard UI.
# Leave unset to disable auth (development only).
DASHBOARD_PASSWORD=change-me-before-deploying

# ─── MCP Health Check ────────────────────────────────────────────────────────
# Interval in milliseconds for client-side MCP health auto-refresh.
# Default: 30000 (30 seconds)
MCP_HEALTH_CHECK_INTERVAL=30000

# ─── MCP Server Configuration ────────────────────────────────────────────────
# JSON array of MCPServerDefinition objects for health checks and routing.
# See src/types/mcp.ts for the MCPServerDefinition interface.
# Example (SSE server):
# MCP_SERVERS_JSON=[{"id":"airtable","name":"Airtable MCP","transport":{"type":"sse","url":"http://localhost:8080/sse"},"tools":["list_records","create_record"]}]
# Example (Stdio server):
# MCP_SERVERS_JSON=[{"id":"filesystem","name":"FS MCP","transport":{"type":"stdio","command":"npx","args":["@modelcontextprotocol/server-filesystem","."]},"tools":["read_file","write_file"]}]
MCP_SERVERS_JSON=[]

# ─── Airtable Webhook ────────────────────────────────────────────────────────
# HMAC-SHA256 secret for verifying Airtable webhook payloads.
# Set this in your Airtable webhook configuration.
# If unset, signature verification is skipped (NOT recommended in production).
AIRTABLE_WEBHOOK_SECRET=

# ─── Sync Defaults ───────────────────────────────────────────────────────────
# Default global context used when webhook auto-sync is triggered.
DEFAULT_GLOBAL_CONTEXT=

# Default targets JSON array (LLMTarget[]) for webhook-triggered syncs.
# Example: [{"id":"cursor","enabled":true,"format":"cursorrules"},{"id":"claude","enabled":true,"format":"knowledge-base"}]
DEFAULT_TARGETS=[]

# ─── App URL ─────────────────────────────────────────────────────────────────
# Full URL of the deployed app. Used internally for webhook → sync calls.
# In Vercel this is set automatically via VERCEL_URL, but set it here for local dev.
NEXTAUTH_URL=http://localhost:3000

# ─── Estate Memory (sovereign document RAG) ──────────────────────────────────
# OpenAI-compatible chat completions endpoint. Works with vLLM, Ollama,
# llama.cpp server, LM Studio, etc. Leave unset to run in stub mode
# (retrieval works; answers just echo the top excerpt verbatim).
# Example for a vLLM server on the local Blackwell box:
#   ESTATE_LLM_BASE_URL=http://localhost:8000/v1
ESTATE_LLM_BASE_URL=
ESTATE_LLM_MODEL=llama-3.3-70b-instruct
# Most local servers ignore this. Set only if your endpoint requires auth.
ESTATE_LLM_API_KEY=
